# Optional remote artifact handoff for swarm-worker.
# Copy values into the worker host secret manager or process environment.
# Never commit real credentials.
SWARM_ARTIFACT_S3_ENDPOINT="https://s3.ru1.storage.beget.cloud"
SWARM_ARTIFACT_S3_REGION="ru-1"
SWARM_ARTIFACT_S3_BUCKET="replace-with-a-dedicated-swarm-bucket"
SWARM_ARTIFACT_S3_ACCESS_KEY=""
SWARM_ARTIFACT_S3_SECRET_KEY=""
SWARM_ARTIFACT_S3_PREFIX="swarm-artifacts"
