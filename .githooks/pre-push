#!/usr/bin/env bash
# pre-push: блокирует пуш, если в выталкиваемом диапазоне есть реальный секрет.
# Активация (один раз на клон): git config core.hooksPath .githooks
#
# stdin (git): <local ref> <local sha> <remote ref> <remote sha>, по строке на пуш.
set -Eeuo pipefail
root="$(git rev-parse --show-toplevel)"

rc=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Удаление ветки (нулевой sha) — проверять нечего.
  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac
  if [[ "$remote_sha" =~ ^0+$ ]]; then
    # Новая ветка на remote: диапазон от merge-base с origin/master (или все коммиты).
    base="$(git merge-base "$local_sha" origin/master 2>/dev/null || true)"
    range="${base:+$base..$local_sha}"
    [[ -n "$range" ]] || range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  if ! bash "$root/scripts/secret_scan.sh" "$range"; then
    rc=1
  fi
done
exit "$rc"
