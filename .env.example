# Обязательно
DB_PASSWORD=<замените на 64-символьный пароль>

# Пароли сервисных ролей БД (step2/roles.sql). Без них compose не стартует.
# Сгенерировать: head -c 24 /dev/urandom | base64 | tr -d '/+='
SWARM_PW_WORKER=<замените>
SWARM_PW_WATCHDOG=<замените>
SWARM_PW_PLANNER=<замените>
SWARM_PW_REVIEWER=<замените>
SWARM_PW_OPERATOR=<замените>
SWARM_PW_CLI=<замените>

# Пароли воркер-ролей (step2b/roles_2b.sql). Без них compose не стартует.
SWARM_PW_W1=<замените>
SWARM_PW_W2=<замените>
SWARM_PW_W_1=<замените>
SWARM_PW_GPU_1=<замените>

# --- v0.4: shell tools + Docker sandbox (необязательно) ---
# WORKER_SHELL_TOOLS=1 включает Agent Loop с shell-командами.
# ВНИМАНИЕ: требует доступа к Docker-сокету (см. docs/KNOWN_LIMITATIONS.md §6).
# Рекомендуется socket-proxy, а не голый сокет: ops/docker-socket-proxy.md.
WORKER_SHELL_TOOLS=0
WORKER_ALLOWED_COMMANDS=bash,cargo,git,cat,ls,echo,mkdir,touch

# Параметры sandbox (читаются SandboxConfig::from_env, см. crates/swarm-worker/src/sandbox.rs).
WORKER_SANDBOX_IMAGE=agent-sandbox:1.85
WORKER_SANDBOX_MEMORY=2g
WORKER_SANDBOX_CPUS=2
# N4: 256 процессов может быть мало для cargo build с параллельными rustc;
# поднимите для крупных воркспейсов.
WORKER_SANDBOX_PIDS_LIMIT=256
WORKER_SANDBOX_CMD_TIMEOUT_SEC=60
WORKER_SANDBOX_MAX_OUTPUT_BYTES=10485760
WORKER_SANDBOX_NETWORK=none

# Тестам/скриптам (worker_sandbox.rs, run_mutations_v04.sh) нужен SANDBOX_IMAGE
# без префикса — то же значение, что WORKER_SANDBOX_IMAGE.
SANDBOX_IMAGE=agent-sandbox:1.85

# --- Issue #3/#4: предохранители расходов и контролируемый проход ---
# Issue #3: глобальный лимит расходов воркера (USD, из cost ledger).
# Проверяется ПЕРЕД каждым LLM-вызовом; fail-closed при недоступном ledger.
MAX_TOTAL_COST_USD=5.0
# Issue #3: сколько подряд неудачных задач терпим до самоотключения воркера.
MAX_CONSECUTIVE_ERRORS=5

# Issue #4: жёсткие пределы ОДНОГО прохода воркера.
# 0 = без лимита (штатный долгоживущий воркер не меняет поведение).
# MAX_LLM_CALLS — максимум LLM-вызовов за проход (ретраи тоже считаются).
MAX_LLM_CALLS=0
# MAX_DURATION_SEC — максимум секунд с начала прохода.
MAX_DURATION_SEC=0
# RUN_ONCE=1 — один проход (одна задача) и выход; удобно для контролируемого
# прогона роя на одной задаче без бесконечных повторов.
RUN_ONCE=0
